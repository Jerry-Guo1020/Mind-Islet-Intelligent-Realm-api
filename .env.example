# Server only. Docker Compose builds DATABASE_URL from these values.
# Do not commit the real file. API_IMAGE is overwritten by GitHub Actions.
MYSQL_DATABASE="healthy_island"
MYSQL_USER="island"
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
API_PORT="3000"
API_IMAGE=""

# WeChat mini program. Never send appsecret to the client.
WX_APPID=""
WX_APPSECRET=""

# HMAC keys for the public session token and the WeChat openid. Use long random strings.
AUTH_TOKEN_SECRET="change-me-token"
WECHAT_HASH_SECRET="change-me-wechat"

# Session lifetime in seconds. 2592000 is 30 days.
AUTH_SESSION_TTL_SECONDS="2592000"

# OpenAI-compatible model endpoint. Keys stay on the server.
AI_BASE_URL="https://api.siliconflow.cn/v1"
AI_API_KEY=""
AI_SMALL_MODEL=""
AI_LARGE_MODEL=""

# Comma-separated HTTPS image URLs on Cloudflare R2, one per asset type is optional.
# Example: flower|https://cdn.example.com/flower.png,tree|https://cdn.example.com/tree.png
ASSET_IMAGE_URLS=""

PORT=3000
