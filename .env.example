# MySQL connection used by Prisma. Do not commit a real password.
DATABASE_URL="mysql://root:password@localhost:3306/healthy_island"

# WeChat mini program. Never send appsecret to the client.
WX_APPID=""
WX_APPSECRET=""

# JWT signed after openid is resolved. Use a long random string in production.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=3000
