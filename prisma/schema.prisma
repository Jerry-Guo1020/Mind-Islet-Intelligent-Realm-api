generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// 微信用户。对外 id 是 cuid。openid 是公开标识，不是微信 openid。
model User {
  id               String    @id @default(cuid())
  openid           String    @unique
  wechatOpenidHash String?   @unique @map("wechat_openid_hash")
  nickname         String
  avatar           String
  createdAt        DateTime  @default(now()) @map("created_at")
  lastLoginAt      DateTime? @map("last_login_at")
  /// 精灵引导是否看过了。
  spiritOnboarded  Boolean   @default(false) @map("spirit_onboarded")
  /// 提醒开关。到点提醒由客户端本身完成，这里只存偏好。
  reminderEnabled  Boolean   @default(false) @map("reminder_enabled")
  /// 提醒时间，HH:mm。未设置为空。
  reminderTime     String?   @map("reminder_time") @db.Char(5)

  sessions AuthSession[]
  records  CheckInRecord[]
  assets   IslandAsset[]
  messages ChatMessage[]
  islandProgress IslandProgress?
  islandPlacements IslandPlacement[]

  @@map("users")
}

/// 情绪岛进度。打卡只改这一行，不再每次长一件旧资产。
model IslandProgress {
  userId                 String  @id @map("user_id")
  happyPoints            Int     @default(0) @map("happy_points")
  disappointPoints       Int     @default(0) @map("disappoint_points")
  totalCheckIns          Int     @default(0) @map("total_check_ins")
  consecutiveCheckInDays Int     @default(0) @map("consecutive_check_in_days")
  lastCheckInDate        String? @map("last_check_in_date") @db.Char(10)
  lastMood               MoodType? @map("last_mood")
  season                 Season  @default(spring)
  specialReward          String? @map("special_reward")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("island_progress")
}

/// 已布置的季节物品。普通树只能由首次打卡写入。
model IslandPlacement {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  season    Season
  itemId    String   @map("item_id")
  source    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season, itemId])
  @@index([userId])
  @@map("island_placements")
}

/// 可注销的登录态。库里只存 token 的 HMAC，不存原文。
model AuthSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// 一次成功打卡：情绪、日记正文、AI 鼓励语。同一用户同一自然日只能有一条。
model CheckInRecord {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  /// 上海时区的自然日，格式 YYYY-MM-DD，用来限制每天一次。
  checkInDate String @map("check_in_date") @db.Char(10)
  moodType  MoodType @map("mood_type")
  content   String   @db.Text
  aiReply   String?  @map("ai_reply") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset  IslandAsset?
  nodes  GraphNode[]

  @@unique([userId, checkInDate])
  @@index([userId, createdAt])
  @@map("check_in_records")
}

/// 打卡产出的岛屿资产。图片必须是 Cloudflare R2 的 HTTPS 地址。
model IslandAsset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  recordId  String    @unique @map("record_id")
  assetType AssetType @map("asset_type")
  posX      Float     @map("pos_x")
  posY      Float     @map("pos_y")
  zIndex    Int       @default(0) @map("z_index")
  imgUrl    String    @map("img_url")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  record CheckInRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("island_assets")
}

/// 从打卡正文抽出的情绪关键词。与打卡记录多对多，关键词全局唯一。
model GraphNode {
  id      String          @id @default(cuid())
  keyword String          @unique
  records CheckInRecord[]

  @@map("graph_nodes")
}

/// 精灵每一轮对话。用户输入和拼接完成的助手回复各一行。
model ChatMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

/// 情绪选择器。接口传枚举值，前端展示中文。
enum MoodType {
  ecstatic
  calm
  tired
  anxious
  sad
}

enum AssetType {
  flower
  grass
  tree
  house
  house_blue
}

enum ChatRole {
  user
  assistant
}

enum Season {
  spring
  summer
  autumn
  winter
}
